{
  "name": "piarre",
  "displayName": "Piarre",
  "description": "Voice-first control plane for coding agents.",
  "version": "0.0.1",
  "private": true,
  "publisher": "sysung",
  "repository": {
    "type": "git",
    "url": "https://github.com/sysung/piarre.git"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:piarre.open",
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piarre.open",
        "title": "Piarre: Open"
      },
      {
        "command": "piarre.renameProject",
        "title": "Piarre: Rename Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.proposeTask",
        "title": "Piarre: Propose Task",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Piarre",
      "properties": {
        "piarre.providers": {
          "type": "array",
          "default": [],
          "description": "Requested provider identifiers only. Connections and model calls are not implemented; these settings do not authorize spending or data sharing. Do not enter credentials.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "provider",
              "model"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "conversation",
                  "coding",
                  "speech-input",
                  "speech-output"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
              },
              "model": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
              }
            }
          }
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Piarre requires workspace trust before creating or changing projects."
    }
  },
  "files": [
    "dist/extension.js",
    "README.md"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "test:compile": "node esbuild.test.mjs",
    "test:smoke": "npm run build && npm run test:compile && node test/run.mjs"
  }
}
