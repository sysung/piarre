{
  "name": "piarre",
  "displayName": "Piarre",
  "description": "Centralized orchestration and visibility for coding agents.",
  "version": "0.0.1",
  "private": true,
  "publisher": "sysung",
  "repository": {
    "type": "git",
    "url": "https://github.com/sysung/piarre.git"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:piarre.open",
    "workspaceContains:.git",
    "onView:piarre.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piarre.open",
        "title": "Piarre: Open"
      },
      {
        "command": "piarre.renameProject",
        "title": "Piarre: Rename Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.proposeTask",
        "title": "Piarre: Propose Task",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.stopAll",
        "title": "Piarre: Stop All Work",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.createDiagnosticBundle",
        "title": "Piarre: Create Diagnostic Bundle",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.exportDiagnosticBundle",
        "title": "Piarre: Export Diagnostic Bundle",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.deleteDiagnosticBundle",
        "title": "Piarre: Delete Diagnostic Bundle",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.endSession",
        "title": "Piarre: End Session (Optional Reflection)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.reviewReflection",
        "title": "Piarre: Review Reflection",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "piarre.explanationPreference",
        "title": "Piarre: Explanation Preference",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Piarre",
      "properties": {
        "piarre.providers": {
          "type": "array",
          "default": [],
          "description": "Requested provider/model and configured cost scenarios. Explicit connection, scope review and native per-attempt spending consent are required. Do not enter credentials.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "provider",
              "model"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "conversation",
                  "coding",
                  "speech-input",
                  "speech-output"
                ]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
              },
              "model": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
              },
              "billing": {
                "description": "Configured assumptions, not provider prices or a spend cap. Execution checks the observed auth route. Legacy subscription samples remain historical; execution requires reviewed-v1 isolated samples with matching account/model/effort/context/window bindings.",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "unknown"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "name",
                      "inputUsdPerMillion",
                      "outputUsdPerMillion"
                    ],
                    "properties": {
                      "kind": {
                        "const": "api"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "inputUsdPerMillion": {
                        "type": "number",
                        "minimum": 0
                      },
                      "outputUsdPerMillion": {
                        "type": "number",
                        "minimum": 0
                      },
                      "provenance": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "provider",
                          "model",
                          "serviceTier",
                          "configuredAt",
                          "expiresAt"
                        ],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "serviceTier": {
                            "const": "default"
                          },
                          "configuredAt": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "expiresAt": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "name"
                    ],
                    "properties": {
                      "kind": {
                        "const": "subscription"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "samples": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "model",
                                "window",
                                "tokensUsed",
                                "usedPercentagePoints"
                              ],
                              "properties": {
                                "model": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                },
                                "window": {
                                  "enum": [
                                    "five-hour",
                                    "weekly"
                                  ]
                                },
                                "tokensUsed": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "usedPercentagePoints": {
                                  "type": "number",
                                  "exclusiveMinimum": 0,
                                  "maximum": 100
                                },
                                "provider": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "description": "Provider identifier when the sample was recorded. Must match the selected provider."
                                },
                                "plan": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 100,
                                  "description": "Subscription plan name when recorded. Must match billing.name."
                                }
                              },
                              "oneOf": [
                                {
                                  "required": [
                                    "provider",
                                    "plan"
                                  ]
                                },
                                {
                                  "not": {
                                    "anyOf": [
                                      {
                                        "required": [
                                          "provider"
                                        ]
                                      },
                                      {
                                        "required": [
                                          "plan"
                                        ]
                                      }
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "kind",
                                "sampleId",
                                "provider",
                                "accountHash",
                                "plan",
                                "model",
                                "profile",
                                "serviceTier",
                                "contextMethod",
                                "contextBand",
                                "bucketId",
                                "durationMins",
                                "before",
                                "after",
                                "tokensUsed",
                                "attribution",
                                "provenance"
                              ],
                              "properties": {
                                "kind": {
                                  "const": "reviewed-v1"
                                },
                                "sampleId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                },
                                "provider": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                },
                                "accountHash": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                },
                                "plan": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                },
                                "model": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                },
                                "profile": {
                                  "oneOf": [
                                    {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "kind",
                                        "effort"
                                      ],
                                      "properties": {
                                        "kind": {
                                          "const": "named"
                                        },
                                        "effort": {
                                          "enum": [
                                            "none",
                                            "minimal",
                                            "low",
                                            "medium",
                                            "high",
                                            "xhigh"
                                          ]
                                        }
                                      }
                                    },
                                    {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "kind",
                                        "configurationHash"
                                      ],
                                      "properties": {
                                        "kind": {
                                          "const": "default"
                                        },
                                        "configurationHash": {
                                          "type": "string",
                                          "pattern": "^[a-f0-9]{64}$"
                                        }
                                      }
                                    }
                                  ]
                                },
                                "serviceTier": {
                                  "const": "default"
                                },
                                "contextMethod": {
                                  "const": "serialized-prompt-utf8-v1"
                                },
                                "contextBand": {
                                  "enum": [
                                    "up-to-16KiB",
                                    "up-to-64KiB",
                                    "larger"
                                  ]
                                },
                                "bucketId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                },
                                "durationMins": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "before": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "observedAt",
                                    "resetsAt",
                                    "usedPercent"
                                  ],
                                  "properties": {
                                    "observedAt": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "resetsAt": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "usedPercent": {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 100
                                    }
                                  }
                                },
                                "after": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "observedAt",
                                    "resetsAt",
                                    "usedPercent"
                                  ],
                                  "properties": {
                                    "observedAt": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "resetsAt": {
                                      "type": "integer",
                                      "minimum": 0
                                    },
                                    "usedPercent": {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 100
                                    }
                                  }
                                },
                                "tokensUsed": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "attribution": {
                                  "const": "reviewed-isolated"
                                },
                                "provenance": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512
                                }
                              }
                            }
                          ]
                        },
                        "description": "Measurements are bound to their original provider, plan and model. Legacy samples without provider/plan remain unbound and cannot estimate a percentage.",
                        "maxItems": 100
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "piarre.codexExecutable": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex CLI executable used for an explicit connection. Sign in through the CLI first. No shell arguments or credentials."
        },
        "piarre.localDiscussion.endpoint": {
          "type": "string",
          "default": "http://model-runner.docker.internal/engines/v1",
          "scope": "machine",
          "description": "Discussion-only Docker Model Runner endpoint. Only this internal endpoint or literal loopback HTTP /engines/v1 is accepted. Global settings only; workspace overrides are ignored."
        },
        "piarre.localDiscussion.model": {
          "type": "string",
          "default": "docker.io/ai/qwen3.5:4b-q6_K",
          "scope": "machine",
          "description": "Operator-installed local discussion model. No download, execution, agent tools or cloud fallback. Global settings only."
        },
        "piarre.localDiscussion.digest": {
          "type": "string",
          "default": "ea484046efba5fc126b1b331c2d590a20cb7d3abdfc65366a7f8b547350cd629",
          "scope": "machine",
          "description": "Operator-configured SHA-256 digest for local model provenance. Configuration is not independent verification of installed weights. Global settings only."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piarre",
          "title": "Piarre",
          "icon": "media/piarre.svg"
        }
      ]
    },
    "views": {
      "piarre": [
        {
          "id": "piarre.sidebar",
          "name": "Piarre",
          "type": "webview"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Piarre requires workspace trust before creating or changing projects."
    }
  },
  "files": [
    "dist/extension.js",
    "README.md",
    "native/scoped-publication.py",
    "media/piarre.svg"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "test:compile": "node esbuild.test.mjs",
    "test:smoke": "npm run build && npm run test:compile && node test/run.mjs",
    "test:package": "node scripts/test-package.mjs"
  }
}
