{
  "name": "piarre",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace apps/vscode",
    "check": "npm run lint && npm run typecheck && npm run build && npm run package",
    "lint": "eslint .",
    "package": "npm run package --workspace apps/vscode",
    "test": "npm run test:contract && npm run test:smoke --workspace apps/vscode",
    "test:contract": "node --test test/scaffold-contract.test.mjs test/editor-boundary.test.mjs test/repository-root.test.mjs test/diagnostic-commands.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:acceptance": "node scripts/accept-candidate.mjs",
    "package:candidate": "node scripts/package-candidate.mjs",
    "candidate": "node scripts/candidate-profile.mjs",
    "test:candidate": "node --test test/candidate-profile.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/vscode": "1.144.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
