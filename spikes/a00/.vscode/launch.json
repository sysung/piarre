{
  "version": "0.2.0",
  "configurations": [{
    "name": "Piarre A00 development host",
    "type": "extensionHost",
    "request": "launch",
    "runtimeExecutable": "${execPath}",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
    "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
    "preLaunchTask": "build"
  }]
}
